# Production environment template
ENVIRONMENT=production
DEBUG=False

# Network/server
HOST=0.0.0.0
PORT=8000
WORKERS=4
RELOAD=False

# Security (REQUIRED: do not use defaults)
SECRET_KEY=REPLACE_WITH_LONG_RANDOM_SECRET
JWT_SECRET_KEY=REPLACE_WITH_LONG_RANDOM_JWT_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
ENABLE_AUTHENTICATION=True

# Explicit CORS allowlist (REQUIRED in production)
ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
ALLOW_CREDENTIALS=True
ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
ALLOWED_HEADERS=Authorization,Content-Type

# Provider toggles and keys
ENABLE_OPENAI_PROVIDER=True
ENABLE_ANTHROPIC_PROVIDER=False
ENABLE_GOOGLE_PROVIDER=False
OPENAI_API_KEY=REPLACE_WITH_OPENAI_API_KEY
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Data services
DATABASE_URL=postgresql+asyncpg://user:password@db:5432/bitnet_sme
REDIS_URL=redis://redis:6379/0

# Runtime
RATE_LIMIT=100/minute
ENABLE_RATE_LIMITING=True
ENABLE_CACHING=True
