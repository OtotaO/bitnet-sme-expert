# Production environment template — every line below is required.
ENVIRONMENT=production
DEBUG=False

HOST=0.0.0.0
PORT=8000
WORKERS=4
RELOAD=False

# Required: must not be defaults
SECRET_KEY=REPLACE_WITH_LONG_RANDOM_SECRET
JWT_SECRET_KEY=REPLACE_WITH_LONG_RANDOM_JWT_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
ENABLE_AUTHENTICATION=True

# Required: explicit allowlist (no '*')
ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
ALLOW_CREDENTIALS=True
ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
ALLOWED_HEADERS=Authorization,Content-Type

# Provider keys
OPENAI_API_KEY=REPLACE_WITH_OPENAI_API_KEY
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Per-role LM selection (production-tier models)
DSPY_LM_ROUTER=openai/gpt-4o-mini
DSPY_LM_MATH=openai/gpt-4o
DSPY_LM_CODE=anthropic/claude-sonnet-4-6
DSPY_LM_GENERAL=openai/gpt-4o

# Data services
DATABASE_URL=postgresql+asyncpg://user:password@db:5432/dspy_sme
REDIS_URL=redis://redis:6379/0

# Runtime
RATE_LIMIT=100/minute
ENABLE_RATE_LIMITING=True
ENABLE_CACHING=True

# Observability — recommended for production
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT_NAME=dspy-sme-expert-prod
