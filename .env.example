# Environment: development, testing, staging, production
ENVIRONMENT=development

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=1
RELOAD=True

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Expert defaults
DEFAULT_MODEL=openai/gpt-4o-mini
MAX_TOKENS=2048
TEMPERATURE=0.7

# Security (generate with: openssl rand -hex 32)
SECRET_KEY=change_this_to_a_secure_random_string
JWT_SECRET_KEY=change_this_jwt_secret
ENABLE_AUTHENTICATION=False

# CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000
ALLOW_CREDENTIALS=False
ALLOWED_METHODS=GET,POST,OPTIONS
ALLOWED_HEADERS=Authorization,Content-Type

# Rate limiting
RATE_LIMIT=100/minute
ENABLE_RATE_LIMITING=True

# Provider API keys (DSPy/LiteLLM read these directly)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Per-role LM overrides (LiteLLM model strings)
# DSPY_LM_ROUTER=openai/gpt-4o-mini
# DSPY_LM_MATH=anthropic/claude-haiku-4-5-20251001
# DSPY_LM_CODE=anthropic/claude-sonnet-4-6
# DSPY_LM_GENERAL=openai/gpt-4o-mini

# Local bitnet.cpp provider (optional)
# DSPY_LM_GENERAL=openai/bitnet
# DSPY_LM_GENERAL_API_BASE=http://localhost:8080/v1
# DSPY_LM_GENERAL_API_KEY_ENV=BITNET_DUMMY_KEY
# BITNET_DUMMY_KEY=local

# MLflow tracing (optional — set to enable autolog + experiment tracking)
# MLFLOW_TRACKING_URI=http://localhost:5000
# MLFLOW_EXPERIMENT_NAME=dspy-sme-expert

# CodeExpert sandbox (optional — requires Deno on PATH)
# Set to 1 to enable dspy.ReAct + dspy.PythonInterpreter so the model can
# write candidate code, run it in a Pyodide/WASM sandbox, and iterate.
# CODE_SANDBOX_ENABLED=0
# CODE_SANDBOX_MAX_ITERS=3

# GeneralExpert RAG (optional — requires `pip install '.[rag]'` and a built
# index). When enabled, GeneralProgram switches from ChainOfThought to
# dspy.ReAct with a retrieve(query) tool over LanceDB + BGE-M3 + BGE-Reranker.
# Build the index first with: uv run python scripts/build_rag_index.py
# RAG_ENABLED=0
# RAG_INDEX_PATH=rag/index
# RAG_TABLE_NAME=documents
# RAG_RERANK=1
# RAG_PREFETCH_K=30
# RAG_MAX_ITERS=3
# RAG_EMBEDDER_MODEL=BAAI/bge-m3
# RAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
